{
  "files": [
    {
      "url": "https://github.com/nlohmann/json/releases/download/v3.11.3/json.hpp",
      "dest": "app/utils/nlohmann/json.hpp"
    },
    {
      "url": "https://raw.githubusercontent.com/nothings/stb/master/stb_image.h",
      "dest": "app/utils/imgui/stb_image.h"
    }
  ],
  "zips": [
    {
      "url": "https://sqlite.org/2024/sqlite-amalgamation-3450100.zip",
      "extract_path": "sqlite_ext",
      "mappings": {
        "sqlite_ext/sqlite-amalgamation-3450100/sqlite3.h": "app/utils/sqlite/sqlite3.h",
        "sqlite_ext/sqlite-amalgamation-3450100/sqlite3.c": "app/utils/sqlite/sqlite3.c"
      }
    }
  ],
  "gits": [
    {
      "url": "https://github.com/ocornut/imgui.git",
      "temp_dir": "temp_imgui",
      "mappings": {
        "temp_imgui/*.h": "app/utils/imgui/",
        "temp_imgui/*.cpp": "app/utils/imgui/",
        "temp_imgui/backends/imgui_impl_win32.*": "app/utils/imgui/",
        "temp_imgui/backends/imgui_impl_dx11.*": "app/utils/imgui/"
      }
    }
  ]
}